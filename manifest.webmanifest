{
  "name": "PDF Toolkit",
  "short_name": "PDF Toolkit",
  "description": "Merge, split, sign, compress, protect and convert PDFs. Runs on your device; files are never uploaded.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f4f5f8",
  "theme_color": "#e5484d",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Merge PDFs", "url": "./#merge" },
    { "name": "Compress", "url": "./#compress" },
    { "name": "Sign", "url": "./#sign" }
  ]
}
